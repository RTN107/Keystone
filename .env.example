# Copy this file to .env and fill it in. .env is git ignored. Never commit it.
# Every variable is explained in the README, section "Where the secrets go".

# ---- Required for the local Docker setup ----

# Signs login sessions. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# The local database's own login. Any values work; they only have to match between the
# database and the API, both of which read them from here. Use letters and digits only
# (for example the output of: openssl rand -hex 16), because they are placed inside a URL.
POSTGRES_USER=keystone
POSTGRES_PASSWORD=
POSTGRES_DB=keystone

# ---- Your teams ----

# Teams are created when the API starts, if they do not exist yet. Format: Name:PREFIX,
# separated by semicolons. The prefix is 2 to 4 capital letters and starts that team's
# employee numbers (DEL-001). ADM is reserved for admins. Adding to this list later adds
# teams; it never renames or removes one.
# These three are the sample teams the demo documents in demo-docs/ are written for.
# Replace them with your own.
KEYSTONE_TEAMS="Sales & Marketing:SAL;Delivery:DEL;HR:HR"

# ---- Optional: switch on ingestion and answers ----
# Without these two keys you can sign in and manage teams, people and access, but ingestion
# and answering stay off, and the interface says so.

# Answers. KEYSTONE_ANTHROPIC_KEY is read first; ANTHROPIC_API_KEY is the fallback (some
# hosts reserve that name and do not pass it through).
KEYSTONE_ANTHROPIC_KEY=
ANTHROPIC_API_KEY=
# The Claude model that writes answers. Required when you set an Anthropic key: there is no
# built-in default, because model names are retired over time. Pick one from Anthropic's
# list of models and paste its name here.
ANTHROPIC_MODEL=

# Embeddings.
VOYAGE_API_KEY=
# Either the API base or the full /embeddings endpoint works. Leave empty for the default
# (Voyage's API as served through MongoDB).
VOYAGE_BASE_URL=
# The embedding model. Leave empty for the default. It must be able to return 1024-dimension
# vectors, because that is the size of the database column. If you change it after
# documents were ingested, ingest them again.
VOYAGE_MODEL=

# ---- Optional tuning (empty means the built-in default) ----

# What Keystone refuses and what it answers. Two numbers between 0 and 1; see "Tuning the
# thresholds" in the README. The defaults were measured on the demo documents only.
KEYSTONE_RELEVANCE_FLOOR=
KEYSTONE_BLOCK_MARGIN=

# Questions to embed once at startup so they are fast the first time they are asked,
# separated by |. Empty means none.
KEYSTONE_WARM_QUESTIONS=

# Per-address questions in 10 minutes, deployment-wide questions a day, and how many
# trusted proxies sit in front of the API. See "Limits" in the README.
KEYSTONE_ASKS_PER_IP=
KEYSTONE_DAILY_ASK_CAP=
KEYSTONE_PROXY_HOPS=

# Set to true to refuse every change except signing in and asking.
KEYSTONE_READ_ONLY=false

# ---- Local ports and origin (optional) ----
# DB_PORT=5432
# API_PORT=8080
# WEB_ORIGIN=http://localhost:5173

# ---- Hosted deployment only (set on the host, not used by Compose) ----
# DATABASE_URL=            Pooled Postgres connection string
# DIRECT_DATABASE_URL=     Optional. Used for migrations. Derived from DATABASE_URL on Neon
# WEB_ORIGIN=              The web app's exact origin, for CORS, e.g. https://your-app.vercel.app
# PORT=                    Set by the host
# VITE_API_URL=            Set on the web host: the API's public URL
